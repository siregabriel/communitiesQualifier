# Example environment for Atlas Communities Standards.
# In production, copy these into /etc/atlas/atlas.env on the server
# (referenced by deploy/atlas.service). DO NOT commit real secrets.

# Long random string used to sign sessions. Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-string

# 0 in production (no debugger / no auto-reload), 1 for local development
FLASK_DEBUG=0

# Port gunicorn binds to (must match deploy/atlas.service and nginx-atlas.conf)
PORT=5001

# --- Photo storage (optional) ---------------------------------------------
# Leave S3_BUCKET unset to store photos on the local disk (static/uploads).
# Set it to store inspection photos privately in S3 and serve them via
# short-lived signed URLs. AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY are read
# by boto3 from the environment.
# S3_BUCKET=atlas-standards-uploads
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your-key-id
# AWS_SECRET_ACCESS_KEY=your-secret
# S3_URL_EXPIRY=3600
