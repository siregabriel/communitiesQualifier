# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/
env/

# ---- OS / editor ----
.DS_Store
*.swp

# ---- Secrets / environment ----
.env
*.env
!.env.example

# ---- Live runtime data (persists on the server; seeded from data/seeds/) ----
# These are git-ignored so a deploy (git pull) never overwrites production data.
# Seed copies live in app_mantenimiento/data/seeds/ and ARE tracked.
app_mantenimiento/data/*.json

# ---- Uploaded media (persists on the server) ----
app_mantenimiento/static/uploads/
app_mantenimiento/static/avatars/
app_mantenimiento/static/community_photos/*
!app_mantenimiento/static/community_photos/README.txt
