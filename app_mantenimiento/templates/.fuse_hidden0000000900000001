        let surveyTypes = []; // Store survey types data
        let currentTypeFilter = 'all';
        let currentConditionFilter = 'all';
        let currentSurveyTypeFilter = 'all'; // Add survey type filter
        let currentView = 'dashboard'; // dashboard, reports, my-visits, communities, action-items
