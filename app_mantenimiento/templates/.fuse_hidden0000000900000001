        // Navigation menu click handlers
        console.log('🔧 Setting up navigation event listeners...');
        const navItems = document.querySelectorAll('.nav-item[data-view]');
        console.log(`📋 Found ${navItems.length} navigation items with data-view attribute`);
        
        navItems.forEach((item, index) => {
            const view = item.dataset.view;
            console.log(`  ${index + 1}. Setting up listener for: ${view}`);
            
            item.addEventListener('click', (e) => {
                e.preventDefault();
                console.log(`🖱️ Navigation clicked: ${view}`);
                showView(view);
                
                // Close mobile menu if open
                if (window.innerWidth < 768) {
                    closeSidebar();
                }
            });
        });
        
        console.log('✅ Navigation event listeners setup complete');

        // Inspection Details Modal Functions
        async function viewCommunityDetails(communityName) {
            try {
                // Fetch all inspections
                const response = await fetch('/api/inspections');
                if (!response.ok) {
                    alert('Failed to load inspection details');
                    return;
                }
                
                const data = await response.json();
                
                if (data.status === 'success' && data.submissions) {
                    // Filter submissions for this community
                    const communitySubmissions = data.submissions.filter(
                        submission => submission.community === communityName
                    );
                    
                    if (communitySubmissions.length === 0) {
                        alert('No inspection data found for this community');
                        return;
                    }
                    
                    // Get the most recent submission
                    const latestSubmission = communitySubmissions.sort((a, b) => 
                        new Date(b.submitted_at) - new Date(a.submitted_at)
                    )[0];
                    
                    // Display the modal with inspection details
                    displayInspectionModal(latestSubmission);
                }
            } catch (error) {
                console.error('Error loading inspection details:', error);
                alert('Error loading inspection details');
            }
        }

        function displayInspectionModal(submission) {
            const modal = document.getElementById('inspectionModal');
            const modalBody = document.getElementById('modalBody');
            
            // Calculate score
            const score = calculateCommunityScore(submission.responses);
            const scoreDisplay = score !== null ? `${score}%` : 'N/A';
            
            // Count action items
            const actionItems = countActionItems(submission.responses);
            
            // Format date
            const submittedDate = formatDate(submission.submitted_at);
            const submittedTime = formatTime(submission.submitted_at);
            
            // Get survey type badge
            const surveyTypeBadge = getSurveyTypeBadge(submission.survey_type_id);
            
            // Collect all photos
            const photos = submission.responses
                .filter(r => r.photo_path)
                .map(r => r.photo_path);
            
            // Build modal content
            let modalContent = `
                <div class="inspection-meta">
                    <div class="meta-item">
                        <div class="meta-label">Community</div>
                        <div class="meta-value">${submission.community}</div>
                    </div>
                    <div class="meta-item">
                        <div class="meta-label">Inspector</div>
                        <div class="meta-value">👤 ${submission.username}</div>
                    </div>
                    <div class="meta-item">
                        <div class="meta-label">Survey Type</div>
                        <div class="meta-value">${surveyTypeBadge}</div>
                    </div>
                    <div class="meta-item">
                        <div class="meta-label">Date</div>
                        <div class="meta-value">${submittedDate}</div>
                    </div>
                    <div class="meta-item">
                        <div class="meta-label">Time</div>
                        <div class="meta-value">${submittedTime}</div>
                    </div>
                    <div class="meta-item">
                        <div class="meta-label">Score</div>
                        <div class="meta-value">${scoreDisplay}</div>
                    </div>
                    <div class="meta-item">
                        <div class="meta-label">Action Items</div>
                        <div class="meta-value">${actionItems}</div>
                    </div>
                </div>
                
                <div class="responses-section">
                    <div class="section-title">📝 Inspection Responses</div>
            `;
            
            // Add each response
            if (submission.responses.length === 0) {
                modalContent += '<div class="no-data">No responses recorded</div>';
            } else {
                submission.responses.forEach(response => {
                    const badgeClass = getBadgeClass(response.condition);
                    const badgeIcon = getBadgeIcon(response.condition);
                    
                    modalContent += `
                        <div class="response-card">
                            <div class="response-question">❓ ${response.question_text}</div>
                            <div class="response-condition ${badgeClass}">
                                ${badgeIcon} ${response.condition}
                            </div>
                            ${response.description ? `
                                <div class="response-description">${response.description}</div>
                            ` : ''}
                            ${response.photo_path ? `
                                <div class="response-photo">
                                    <img src="/${response.photo_path}" alt="Response photo">
                                </div>
                            ` : ''}
                        </div>
                    `;
                });
            }
            
            modalContent += '</div>';
            
            // Add photos section if there are any
            if (photos.length > 0) {
                modalContent += `
                    <div class="photos-section">
                        <div class="section-title">📷 Photos (${photos.length})</div>
                        <div class="photos-grid">
                `;
                
                photos.forEach(photoPath => {
                    modalContent += `
                        <div class="photo-item">
                            <img src="/${photoPath}" alt="Inspection photo">
                        </div>
                    `;
                });
                
                modalContent += `
                        </div>
                    </div>
                `;
            }
            
            // Set modal content and show
            modalBody.innerHTML = modalContent;
            modal.classList.add('show');
            
            // Prevent body scroll when modal is open
            document.body.style.overflow = 'hidden';
        }

        function closeInspectionModal() {
            const modal = document.getElementById('inspectionModal');
            modal.classList.remove('show');
            
            // Restore body scroll
            document.body.style.overflow = '';
        }

        function formatTime(isoString) {
            try {
                const date = new Date(isoString);
                const hours = String(date.getHours()).padStart(2, '0');
                const minutes = String(date.getMinutes()).padStart(2, '0');
                return `${hours}:${minutes}`;
            } catch (e) {
                return 'Unknown';
            }
        }

        // Close modal when clicking outside
        document.getElementById('inspectionModal').addEventListener('click', (e) => {
            if (e.target.id === 'inspectionModal') {
                closeInspectionModal();
            }
        });

        // Close modal with Escape key
        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') {
                closeInspectionModal();
                // Also close slide panel if open
                const panel = document.getElementById('slidePanel');
                if (panel && panel.classList.contains('show')) {
                    closeSlidePanel();
                }
            }
        });

        // Slide Panel Event Listeners
        // Close button click
        const slidePanelCloseBtn = document.getElementById('slidePanelClose');
        if (slidePanelCloseBtn) {
            slidePanelCloseBtn.addEventListener('click', closeSlidePanel);
        }

        // Overlay click
        const slidePanelOverlay = document.getElementById('slidePanelOverlay');
        if (slidePanelOverlay) {
            slidePanelOverlay.addEventListener('click', closeSlidePanel);
        }

        // Community card clicks - debounced
        let cardClickTimeout = null;
        function handleCommunityCardClick(event) {
            // Clear any pending click
            if (cardClickTimeout) {
                clearTimeout(cardClickTimeout);
            }
            
            // Debounce for 300ms
            cardClickTimeout = setTimeout(() => {
                const card = event.currentTarget;
                const titleElement = card.querySelector('.card-title');
                
                if (titleElement) {
                    const communityName = titleElement.textContent.trim();
                    if (communityName) {
                        openSlidePanel(communityName);
                    }
                }
            }, 300);
        }

        // Attach click handlers to all community cards
        function attachCommunityCardListeners() {
            const communityCards = document.querySelectorAll('.community-card');
            communityCards.forEach(card => {
                card.style.cursor = 'pointer';
                card.addEventListener('click', handleCommunityCardClick);
            });
        }

        // Call this after community cards are rendered
        // We'll use a MutationObserver to detect when cards are added
        const galleryObserver = new MutationObserver((mutations) => {
            attachCommunityCardListeners();
        });

        const gallery = document.getElementById('gallery');
        if (gallery) {
            galleryObserver.observe(gallery, { childList: true, subtree: true });
            // Also attach to any existing cards
            attachCommunityCardListeners();
        }
    </script>
</body>
</html>
