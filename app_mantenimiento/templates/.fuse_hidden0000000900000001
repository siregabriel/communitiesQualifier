        }

        // Run test on load
        window.addEventListener('DOMContentLoaded', () => {
            console.log('🚀 Dashboard loaded');
            testButtons();
        });

        // Score Calculation Function
        function calculateCommunityScore(responses) {
            if (!responses || responses.length === 0) {
                return null;
            }
            
            const scoreMap = {
                'Pass': 100,
                'Fail': 0
            };

            let totalScore = 0;
            let count = 0;
            
            responses.forEach(response => {
                if (scoreMap.hasOwnProperty(response.condition)) {
                    totalScore += scoreMap[response.condition];
                    count++;
                }
            });
            
            return count > 0 ? Math.round(totalScore / count) : null;
        }

        // Load Survey Types
        async function loadSurveyTypes() {
            try {
                const response = await fetch('/api/survey-types');
                if (response.ok) {
                    const data = await response.json();
                    if (data.status === 'success' && data.survey_types) {
                        surveyTypes = data.survey_types;
                        renderSurveyTypeFilters(); // Render filter buttons
                    }
                }
            } catch (error) {
                console.error('Error loading survey types:', error);
                surveyTypes = [];
            }
        }

        // Render Survey Type Filter Buttons
        function renderSurveyTypeFilters() {
            const container = document.getElementById('surveyTypeFilters');
            if (!container || !surveyTypes.length) return;
            
            container.innerHTML = surveyTypes.map(type => `
                <button class="filter-btn" 
                        data-survey-type="${type.id}" 
                        onclick="filterBySurveyType('${type.id}')"
                        style="border-color: ${type.color}40;">
                    <i class="fas ${type.icon}" style="color: ${type.color};"></i>
                    ${type.name}
                </button>
            `).join('');
        }

        // Filter by Survey Type
        function filterBySurveyType(surveyTypeId) {
            currentSurveyTypeFilter = surveyTypeId;
            
            // Update active button
            document.querySelectorAll('.filter-btn[data-survey-type]').forEach(btn => {
                btn.classList.remove('active');
                if (btn.dataset.surveyType === surveyTypeId) {
                    btn.classList.add('active');
                }
            });
            
            // Re-render based on current view
            if (currentView === 'dashboard' || currentView === 'communities') {
                renderCommunityCards();
            } else if (currentView === 'reports') {
                renderCards();
            } else if (currentView === 'my-visits') {
                renderMyVisits();
            } else if (currentView === 'action-items') {
                renderActionItems();
            }
        }

        // Get Survey Type by ID
        function getSurveyTypeById(surveyTypeId) {
            if (!surveyTypeId || !surveyTypes.length) {
                return null;
            }
            return surveyTypes.find(st => st.id === surveyTypeId);
        }

        // Generate Survey Type Badge HTML
        function getSurveyTypeBadge(surveyTypeId) {
            const surveyType = getSurveyTypeById(surveyTypeId);
            
            if (!surveyType) {
                // Legacy inspection without survey type
                return `
                    <span class="survey-type-badge survey-type-unspecified">
                        <i class="fas fa-question-circle"></i>
                        <span>Unspecified</span>
                    </span>
                `;
            }
            
            return `
                <span class="survey-type-badge" style="background-color: ${surveyType.color}15; color: ${surveyType.color}; border: 1px solid ${surveyType.color}40;">
                    <i class="fas ${surveyType.icon}"></i>
                    <span>${surveyType.name}</span>
                </span>
            `;
        }

        // Action Items Counter Function
        function countActionItems(responses) {
            if (!responses || responses.length === 0) {
                return 0;
            }
            
            const actionConditions = ['Fail'];

            return responses.filter(response =>
                actionConditions.includes(response.condition)
            ).length;
        }

        // Filter Inspections by Community Name
        function filterByCommunity(inspections, communityName) {
            // Handle edge cases
            if (!inspections || !Array.isArray(inspections)) {
                return [];
            }
            
            if (!communityName || typeof communityName !== 'string' || communityName.trim() === '') {
                return [];
            }
            
            // Filter inspections that match the specified community name
            return inspections.filter(inspection => {
                // Handle null/undefined inspection or community field
                if (!inspection || !inspection.community) {
                    return false;
                }
                
                // Case-sensitive exact match
                return inspection.community === communityName;
            });
        }

        // Calculate Average Score from Inspections
        function calculateScore(inspections) {
            // Handle edge cases
            if (!inspections || !Array.isArray(inspections)) {
                return null;
            }
            
            if (inspections.length === 0) {
                return null;
            }
            
            // Map condition types to numeric scores
            function getConditionScore(condition) {
                const scoreMap = {
                    'Pass': 100,
                    'Fail': 0
                };

                return scoreMap[condition] !== undefined ? scoreMap[condition] : null;
            }
            
            let totalScore = 0;
            let scoredCount = 0;
            
            // Calculate total score from all inspections with valid conditions
            for (const inspection of inspections) {
                if (!inspection || !inspection.condition) {
                    continue;
                }
                
                const conditionScore = getConditionScore(inspection.condition);
                
                if (conditionScore !== null) {
                    totalScore += conditionScore;
                    scoredCount++;
                }
            }
            
            // Return null if no scoreable inspections exist
            if (scoredCount === 0) {
                return null;
            }
            
            // Calculate average and round to nearest integer
            const averageScore = totalScore / scoredCount;
            return Math.round(averageScore);
        }

        // Count Action Items from Inspections
        function countActionItems(inspections) {
            // Handle edge cases
            if (!inspections || !Array.isArray(inspections)) {
                return 0;
            }
            
            // Define action-requiring conditions
            const actionConditions = ['Fail'];

            let count = 0;
            
            // Count inspections with action-requiring conditions
            for (const inspection of inspections) {
                if (!inspection || !inspection.condition) {
                    continue;
                }
                
                if (actionConditions.includes(inspection.condition)) {
                    count++;
                }
            }
            
            return count;
        }

        // Group Responses by Condition
        function groupResponsesByCondition(inspections) {
            if (!inspections || !Array.isArray(inspections)) {
                return [];
            }
            
            // Define severity order for sorting (Fail first)
            const severityOrder = {
                'Fail': 1,
                'Pass': 2
            };
            
            // Map inspections to ResponseGroup format
            const responses = inspections
                .filter(inspection => inspection && inspection.condition)
                .map(inspection => ({
                    condition: inspection.condition,
                    conditionClass: getBadgeClass(inspection.condition),
                    conditionIcon: getBadgeIcon(inspection.condition),
                    questionText: inspection.question_text || inspection.questionText || 'N/A',
                    description: inspection.description || '',
                    photoPath: inspection.photo_path || inspection.photoPath || null,
                    timestamp: inspection.submitted_at || inspection.timestamp || ''
                }));
            
            // Sort by severity (Fail first, Pass last)
            responses.sort((a, b) => {
                const orderA = severityOrder[a.condition] || 999;
                const orderB = severityOrder[b.condition] || 999;
                return orderA - orderB;
            });
            
            return responses;
        }

        // Extract Photos from Inspections
        function extractPhotos(inspections) {
            if (!inspections || !Array.isArray(inspections)) {
                return [];
            }
            
            const photoMap = new Map();
            
            for (const inspection of inspections) {
                if (!inspection) continue;
                
                const photoPath = inspection.photo_path || inspection.photoPath;
                
                if (photoPath && photoPath.trim() !== '') {
                    // Deduplicate by path
                    if (!photoMap.has(photoPath)) {
                        photoMap.set(photoPath, {
                            path: photoPath,
                            alt: inspection.question_text || inspection.questionText || 'Inspection photo',
                            timestamp: inspection.submitted_at || inspection.timestamp || ''
                        });
                    }
                }
            }
            
            return Array.from(photoMap.values());
        }

        // --- API response cache (Task 11.1) ---
        // Cache /api/inspections for 30s to avoid refetching on every panel open.
        const INSPECTIONS_CACHE_TTL = 30000; // 30 seconds
        let inspectionsCache = { data: null, timestamp: 0 };

        async function fetchInspectionsCached() {
            const now = Date.now();
            if (inspectionsCache.data && (now - inspectionsCache.timestamp) < INSPECTIONS_CACHE_TTL) {
                return inspectionsCache.data;
            }

            const response = await fetch('/api/inspections');
            if (!response.ok) {
                throw new Error(`API request failed: ${response.status}`);
            }
            const data = await response.json();
            inspectionsCache = { data: data, timestamp: now };
            return data;
        }

        // Open Slide Panel
        async function openSlidePanel(communityName) {
            // Input validation
            if (!communityName || typeof communityName !== 'string' || communityName.trim() === '') {
                console.warn('Invalid community name provided to openSlidePanel');
                return;
            }

            try {
                // Fetch inspection data (cached for 30s)
                const data = await fetchInspectionsCached();

                // Check if API returned success
                if (data.status !== 'success' || !data.submissions) {
                    throw new Error('Invalid API response format');
                }
                
                // Filter submissions by community
                const communitySubmissions = data.submissions.filter(
                    submission => submission.community === communityName
                );
                
                // Check if data exists
                if (communitySubmissions.length === 0) {
                    renderEmptyState('No visit data available for this community');
                    showPanel();
                    showOverlay();
                    return;
                }
                
                // Get the most recent submission
                const latestSubmission = communitySubmissions.sort((a, b) => 
                    new Date(b.submitted_at) - new Date(a.submitted_at)
                )[0];
                
                // Flatten all responses from all submissions for this community
                const allResponses = communitySubmissions.flatMap(sub => sub.responses || []);
                
                // Calculate metrics
                const score = calculateScore(allResponses);
                const actionItems = countActionItems(allResponses);
                
                // Get latest timestamp
                const lastVisitDate = latestSubmission.submitted_at 
                    ? new Date(latestSubmission.submitted_at).toLocaleDateString()
                    : 'N/A';
                
                // Process responses and photos
                const responses = groupResponsesByCondition(allResponses);
                const photos = extractPhotos(allResponses);
                
                // Debug logging
                console.log('Community:', communityName);
                console.log('All responses:', allResponses);
                console.log('Grouped responses:', responses);
                console.log('Photos:', photos);
                console.log('Score:', score);
                console.log('Action items:', actionItems);
                
                // Build data object
                const detailData = {
                    communityName: communityName,
                    lastVisitDate: lastVisitDate,
                    score: score,
                    actionItems: actionItems,
                    responses: responses,
                    photos: photos,
                    totalResponses: allResponses.length
                };
                
                // Render and display
                renderPanelContent(detailData);
                showPanel();
                showOverlay();
                
            } catch (error) {
                console.error('Error opening slide panel:', error);
                alert('Failed to load community details. Please try again.');
            }
        }

        // --- Focus management (Tasks 12.2 / 12.3) ---
        let lastFocusedElement = null; // element that triggered the panel

        // Return all keyboard-focusable elements currently inside the panel
        function getPanelFocusableElements() {
            const panel = document.getElementById('slidePanel');
            if (!panel) return [];
            const selector = 'a[href], button:not([disabled]), textarea, input, select, [tabindex]:not([tabindex="-1"])';
            return Array.from(panel.querySelectorAll(selector))
                .filter(el => el.offsetParent !== null); // visible only
        }

        // Trap Tab focus within the panel while it is open
        function trapPanelFocus(e) {
            const panel = document.getElementById('slidePanel');
            if (!panel || !panel.classList.contains('show')) return;
            if (e.key !== 'Tab') return;

            const focusable = getPanelFocusableElements();
            if (focusable.length === 0) {
                e.preventDefault();
                return;
            }
            const first = focusable[0];
            const last = focusable[focusable.length - 1];

            if (e.shiftKey && document.activeElement === first) {
                e.preventDefault();
                last.focus();
            } else if (!e.shiftKey && document.activeElement === last) {
                e.preventDefault();
                first.focus();
            }
        }

        // Close Slide Panel
        function closeSlidePanel() {
            const panel = document.getElementById('slidePanel');
            const overlay = document.getElementById('slidePanelOverlay');

            if (panel) {
                panel.classList.remove('show');
                panel.setAttribute('aria-hidden', 'true');
            }

            if (overlay) {
                overlay.classList.remove('show');
                overlay.setAttribute('aria-hidden', 'true');
            }

            // Remove focus trap
            document.removeEventListener('keydown', trapPanelFocus, true);

            // Re-enable body scroll
            document.body.style.overflow = 'auto';

            // Restore focus to the element that opened the panel
            if (lastFocusedElement && typeof lastFocusedElement.focus === 'function') {
                lastFocusedElement.focus();
            }
            lastFocusedElement = null;
        }

        // Show Panel
        function showPanel() {
            const panel = document.getElementById('slidePanel');
            if (panel) {
                // Remember what had focus so we can restore it on close
                lastFocusedElement = document.activeElement;

                panel.classList.add('show');
                panel.setAttribute('aria-hidden', 'false');

                // Prevent background scroll while open
                document.body.style.overflow = 'hidden';

                // Activate focus trap and move focus into the panel
                document.addEventListener('keydown', trapPanelFocus, true);
                const closeBtn = document.getElementById('slidePanelClose');
                if (closeBtn) {
                    closeBtn.focus();
                } else {
                    const body = document.getElementById('slidePanelBody');
                    if (body) body.focus();
                }
            }
        }

        // Show Overlay
        function showOverlay() {
            const overlay = document.getElementById('slidePanelOverlay');
            if (overlay) {
                overlay.classList.add('show');
                overlay.setAttribute('aria-hidden', 'false');
            }
        }

