        async function loadInspections() {
            try {
                const response = await fetch('/api/inspections');
                if (!response.ok) {
                    console.error('Failed to load inspections');
                    return;
                }
                
                const data = await response.json();
                
                if (data.status === 'success' && data.submissions) {
                    // Transform inspection submissions into individual response cards
                    allInspections = [];
                    
                    data.submissions.forEach(submission => {
                        submission.responses.forEach(response => {
                            allInspections.push({
                                type: 'inspection',
                                questionText: response.question_text,
                                condition: response.condition,
                                description: response.description,
                                photoPath: response.photo_path,
                                username: submission.username,
                                community: submission.community,
                                surveyTypeId: submission.survey_type_id, // Add survey type ID
                                timestamp: formatTimestamp(response.answered_at),
                                submittedAt: submission.submitted_at
                            });
                        });
                    });
                    
                    renderCards();
                }
            } catch (error) {
                console.error('Error loading inspections:', error);
            }
        }

        function formatTimestamp(isoString) {
            try {
                const date = new Date(isoString);
                const year = date.getFullYear();
                const month = String(date.getMonth() + 1).padStart(2, '0');
                const day = String(date.getDate()).padStart(2, '0');
                const hours = String(date.getHours()).padStart(2, '0');
                const minutes = String(date.getMinutes()).padStart(2, '0');
                return `${year}-${month}-${day} ${hours}:${minutes}`;
            } catch (e) {
                return isoString;
            }
        }

        function getBadgeClass(condition) {
            const conditionMap = {
                'Pass': 'badge-pass',
                'Fail': 'badge-fail'
            };
            return conditionMap[condition] || 'badge-pass';
        }

        function getBadgeIcon(condition) {
            const iconMap = {
                'Pass': '✓',
                'Fail': '❌'
            };
            return iconMap[condition] || '•';
        }

        function renderCards() {
            const gallery = document.getElementById('gallery');
            
            // Combine all items
            let allItems = [...allReports, ...allInspections];
            
            // Apply type filter
            if (currentTypeFilter === 'maintenance') {
                allItems = allItems.filter(item => item.type === 'maintenance');
            } else if (currentTypeFilter === 'inspection') {
                allItems = allItems.filter(item => item.type === 'inspection');
            }
            
            // Apply condition filter (Pass/Fail)
            if (currentConditionFilter === 'pass') {
                allItems = allItems.filter(item => item.condition === 'Pass');
            } else if (currentConditionFilter === 'fail') {
                allItems = allItems.filter(item => item.condition === 'Fail');
            }
            
            // Apply survey type filter
            if (currentSurveyTypeFilter !== 'all') {
                allItems = allItems.filter(item => {
                    // Only filter inspections (maintenance reports don't have survey types)
                    if (item.type !== 'inspection') return true;
                    // Match the survey type ID
                    return item.surveyTypeId === currentSurveyTypeFilter;
                });
            }

            if (allItems.length === 0) {
                gallery.innerHTML = '<div class="empty-state"><i class="fas fa-search"></i><p>No items match this filter</p></div>';
                return;
            }

            gallery.innerHTML = allItems.map(item => {
                const badgeClass = getBadgeClass(item.condition);
                const badgeIcon = getBadgeIcon(item.condition);
                
                if (item.type === 'maintenance') {
                    // Render maintenance report card
