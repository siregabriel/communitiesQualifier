                    // Maryland
                    "Tribute at Black Hill",
                    "Tribute at Melford",
                    
                    // Virginia
                    "Tribute at One Loudoun",
                    "Tribute at The Glen"
                ];
                
                const response = await fetch('/api/inspections');
                let communityMap = {};
                
                if (response.ok) {
                    const data = await response.json();
                    
                    if (data.status === 'success' && data.submissions) {
                        // Group submissions by community
                        data.submissions.forEach(submission => {
                            const community = submission.community;
                            
                            if (!communityMap[community]) {
                                communityMap[community] = {
                                    name: community,
                                    submissions: []
                                };
                            }
                            
                            communityMap[community].submissions.push(submission);
                        });
                    }
                }
                
                // Process ALL communities (with or without data)
                communityData = [];
                
                for (const communityName of allCommunities) {
                    if (communityMap[communityName]) {
                        // Community has inspection data
                        const sortedSubmissions = communityMap[communityName].submissions.sort((a, b) => 
                            new Date(b.submitted_at) - new Date(a.submitted_at)
                        );
                        
                        const latestSubmission = sortedSubmissions[0];
                        
                        // Calculate score and action items
                        const score = calculateCommunityScore(latestSubmission.responses);
                        const actionItems = countActionItems(latestSubmission.responses);
                        
                        communityData.push({
                            name: communityName,
                            lastVisit: formatDate(latestSubmission.submitted_at),
                            score: score,
                            actionItems: actionItems,
                            photoUrl: getCommunityPhoto(communityName)
                        });
                    } else {
                        // Community has no inspection data yet - show with N/A
                        communityData.push({
                            name: communityName,
                            lastVisit: 'No visits yet',
                            score: null,
                            actionItems: 0,
                            photoUrl: getCommunityPhoto(communityName)
                        });
                    }
                }
                
                // Filter by user role if staff
                if (!isAdmin && currentUserCommunity) {
                    communityData = communityData.filter(c => c.name === currentUserCommunity);
                }
                
            } catch (error) {
                console.error('Error loading community data:', error);
                communityData = [];
            }
        }

        function formatDate(isoString) {
            try {
                const date = new Date(isoString);
                const options = { year: 'numeric', month: 'short', day: 'numeric' };
                return date.toLocaleDateString('en-US', options);
            } catch (e) {
                return 'Unknown';
            }
        }

        function getCommunityPhoto(communityName) {
            // Generate a consistent gradient based on community name
            const colors = [
                ['#667eea', '#764ba2'],
                ['#f093fb', '#f5576c'],
                ['#4facfe', '#00f2fe'],
                ['#43e97b', '#38f9d7'],
                ['#fa709a', '#fee140'],
                ['#30cfd0', '#330867'],
                ['#a8edea', '#fed6e3'],
                ['#ff9a9e', '#fecfef']
            ];
            
            const index = communityName.charCodeAt(communityName.length - 1) % colors.length;
            const [color1, color2] = colors[index];
            
            return `linear-gradient(135deg, ${color1} 0%, ${color2} 100%)`;
        }

        // Render Community Cards with Filters
        function renderCommunityCards() {
            const gallery = document.getElementById('gallery');
            
            if (communityData.length === 0) {
                gallery.innerHTML = '<div class="empty-state"><i class="fas fa-building"></i><p>No community data available</p></div>';
                return;
            }
            
            // Apply filters to community data
            let filteredCommunities = [...communityData];
            
            // Apply condition filter based on score
            if (currentConditionFilter !== 'all') {
                filteredCommunities = filteredCommunities.filter(community => {
                    const score = community.score;
                    
                    // Skip communities without scores for specific condition filters
                    if (score === null && currentConditionFilter !== 'all') {
                        return false;
                    }
                    
                    switch(currentConditionFilter) {
                        case 'excellence':
                            return score === 100;
                        case 'pass':
                            return score >= 75 && score < 100;
                        case 'opportunity':
                            return score >= 50 && score < 75;
                        case 'fail':
                            return score < 50;
                        default:
                            return true;
                    }
                });
            }
            
            if (filteredCommunities.length === 0) {
                gallery.innerHTML = '<div class="empty-state"><i class="fas fa-search"></i><p>No communities match this filter</p></div>';
                return;
            }
            
            gallery.innerHTML = filteredCommunities.map(community => {
                // Handle null score - display "N/A" in progress indicator
                const score = community.score !== null ? community.score : 'N/A';
                const scoreClass = score === 'N/A' ? 'na' : '';
                
                // Only apply progress class if score is not N/A
                const progressClass = score === 'N/A' ? '' : (score >= 75 ? '' : (score >= 50 ? 'warning' : 'danger'));
                
                // Calculate stroke offset - full circle (283) when N/A
                const strokeDashoffset = score !== 'N/A' ? Math.round(283 - (283 * score / 100)) : 283;
                
                const actionClass = community.actionItems > 0 ? 'has-actions' : '';
                const hasData = community.score !== null;
                
                // Handle null lastVisit - display "No visits yet"
                const lastVisitText = community.lastVisit || 'No visits yet';
                
                return `
                    <div class="community-card">
                        <div class="card-image" style="background: ${community.photoUrl}">
                            <i class="fas fa-building"></i>
                        </div>
                        <div class="card-content">
