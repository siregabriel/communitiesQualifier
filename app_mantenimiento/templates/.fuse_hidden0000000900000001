                            <div class="card-date">Last visit: ${lastVisitText}</div>
                            
                            <div class="circular-progress">
                                <svg viewBox="0 0 100 100">
                                    <circle class="progress-bg" cx="50" cy="50" r="45"></circle>
                                    <circle class="progress-bar ${progressClass}" cx="50" cy="50" r="45" 
                                            style="stroke-dashoffset: ${strokeDashoffset}"></circle>
                                </svg>
                                <div class="progress-value ${scoreClass}">${score}${score !== 'N/A' ? '%' : ''}</div>
                            </div>
                            
                            <div class="action-items ${actionClass}">
                                <i class="fas ${community.actionItems > 0 ? 'fa-exclamation-circle' : 'fa-check-circle'}"></i>
                                <span>${community.actionItems} Open Action${community.actionItems !== 1 ? 's' : ''}</span>
                            </div>
                            
