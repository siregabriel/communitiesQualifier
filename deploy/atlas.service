[Unit]
Description=Atlas Communities Standards (gunicorn)
After=network.target

[Service]
Type=simple
User=ubuntu
# Adjust this path if you cloned the repo somewhere else
WorkingDirectory=/home/ubuntu/CommunitiesQualifier/app_mantenimiento
# SECRET_KEY (and any other env) come from this file — create it, do NOT commit it
EnvironmentFile=-/etc/atlas/atlas.env
ExecStart=/home/ubuntu/CommunitiesQualifier/.venv/bin/gunicorn \
    --workers 3 \
    --bind 127.0.0.1:5001 \
    --timeout 60 \
    app:app
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
